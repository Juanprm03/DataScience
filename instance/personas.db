DROP TABLE IF EXISTS Personas;
CREATE TABLE  Personas (
    id INT PRIMARY KEY,
    nombreCompleto VARCHAR(50),
    correo VARCHAR(100),
    celular VARCHAR(20),
    edad INT,
    sexo VARCHAR(10),
    pais VARCHAR(50),
    saludFisica INT,
    saludEmocional INT,
    familia INT,
    amigos INT,
    vidaSocial INT,
    diversion INT,
    estudios INT,
    finanzas INT,
    desarrolloPersonal INT,
    espiritual INT
);

